{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morningrows.com/schema.json",
  "title": "Morning Rows catalogue, desk and selected-response contracts",
  "type": "object",
  "$defs": {
    "retrieval": {
      "type": "object",
      "required": [
        "status",
        "retrieved_at"
      ],
      "properties": {
        "status": {
          "enum": [
            "ok",
            "degraded",
            "error"
          ]
        },
        "retrieved_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "type": "string"
        }
      }
    },
    "observation": {
      "type": "object",
      "required": [
        "id",
        "measure",
        "value",
        "value_state",
        "period",
        "definition",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uri"
        },
        "measure": {
          "type": "string",
          "format": "uri"
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "value_state": {
          "enum": [
            "observed",
            "suppressed",
            "missing",
            "unavailable"
          ]
        },
        "period": {
          "type": "string"
        },
        "definition": {
          "type": "object"
        },
        "version": {
          "type": "string"
        },
        "published_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "publisher_updated_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "next_expected_update": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "selected": {
      "type": "object",
      "required": [
        "schema_version",
        "id",
        "retrieval",
        "data",
        "observations"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "id": {
          "type": "string",
          "format": "uri"
        },
        "source": {
          "type": "string",
          "format": "uri"
        },
        "data": {
          "description": "Existing native section, or the selected native row. Null on failed retrieval. Caveats are also retained in context."
        },
        "context": {
          "type": "object"
        },
        "retrieval": {
          "$ref": "#/$defs/retrieval"
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observation"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "source"
            ],
            "properties": {
              "source": {
                "const": "https://morningrows.com/united-kingdom.json?source=claimant_count"
              }
            },
            "not": {
              "required": [
                "error"
              ]
            }
          },
          "then": {
            "required": [
              "context"
            ],
            "properties": {
              "retrieval": {
                "properties": {
                  "status": {
                    "const": "ok"
                  }
                }
              },
              "context": {
                "required": [
                  "definition",
                  "metadata",
                  "provenance"
                ],
                "properties": {
                  "definition": {
                    "const": {
                      "id": "claimants",
                      "name": "Claimant count, all sexes, age 16+",
                      "geography": "United Kingdom",
                      "geography_code": "K02000001",
                      "population": "All sexes, age 16 and over: Jobseeker’s Allowance claimants and relevant Universal Credit claimants under the publisher’s claimant-count eligibility and administrative definitions.",
                      "unit": "persons",
                      "adjustment": "not seasonally adjusted",
                      "kind": "observation",
                      "period_convention": "Publisher monthly reference-date stock, identified by YYYY-MM; not a monthly sum or mean.",
                      "cadence": "monthly",
                      "rounding": "Nearest five persons",
                      "dimensions": {
                        "dataset": "NM_162_1",
                        "gender": "0",
                        "age": "0",
                        "measure": "1",
                        "measures": "20100",
                        "geography": "K02000001"
                      },
                      "publisher": "Office for National Statistics / Nomis",
                      "licence": "Open Government Licence v3.0",
                      "licence_url": "https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/",
                      "source_url": "https://www.nomisweb.co.uk/api/v01/dataset/NM_162_1.data.csv?geography=K02000001,E92000001,S92000003,W92000004,N92000002&date=latestMINUS12-latest&gender=0&age=0&measure=1&measures=20100",
                      "revision_policy": "Previous months and longer histories can be revised. Retain the publisher revision metadata; current values are not a vintage archive.",
                      "limitations": "Administrative claimant stock, not ILO unemployment, a claimant rate or available recruits. Universal Credit eligibility, work-search conditions, rollout, classification and policy changes affect coverage and comparisons; arrangements can differ in Northern Ireland. JSA and relevant UC claimants are combined under the publisher definition; overlapping benefit populations must not be added again. Exact retained national months only; no local areas, seasonal adjustment, missing-to-zero conversion or older-release substitution."
                    }
                  }
                }
              },
              "observations": {
                "items": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/claimantObservation"
                    },
                    {
                      "properties": {
                        "definition": {
                          "const": {
                            "id": "claimants",
                            "name": "Claimant count, all sexes, age 16+",
                            "geography": "United Kingdom",
                            "geography_code": "K02000001",
                            "population": "All sexes, age 16 and over: Jobseeker’s Allowance claimants and relevant Universal Credit claimants under the publisher’s claimant-count eligibility and administrative definitions.",
                            "unit": "persons",
                            "adjustment": "not seasonally adjusted",
                            "kind": "observation",
                            "period_convention": "Publisher monthly reference-date stock, identified by YYYY-MM; not a monthly sum or mean.",
                            "cadence": "monthly",
                            "rounding": "Nearest five persons",
                            "dimensions": {
                              "dataset": "NM_162_1",
                              "gender": "0",
                              "age": "0",
                              "measure": "1",
                              "measures": "20100",
                              "geography": "K02000001"
                            },
                            "publisher": "Office for National Statistics / Nomis",
                            "licence": "Open Government Licence v3.0",
                            "licence_url": "https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/",
                            "source_url": "https://www.nomisweb.co.uk/api/v01/dataset/NM_162_1.data.csv?geography=K02000001,E92000001,S92000003,W92000004,N92000002&date=latestMINUS12-latest&gender=0&age=0&measure=1&measures=20100",
                            "revision_policy": "Previous months and longer histories can be revised. Retain the publisher revision metadata; current values are not a vintage archive.",
                            "limitations": "Administrative claimant stock, not ILO unemployment, a claimant rate or available recruits. Universal Credit eligibility, work-search conditions, rollout, classification and policy changes affect coverage and comparisons; arrangements can differ in Northern Ireland. JSA and relevant UC claimants are combined under the publisher definition; overlapping benefit populations must not be added again. Exact retained national months only; no local areas, seasonal adjustment, missing-to-zero conversion or older-release substitution."
                          }
                        },
                        "measure": {
                          "const": "https://morningrows.com/united-kingdom.json?source=claimant_count&measure=claimants"
                        },
                        "qualifications": {
                          "allOf": [
                            {
                              "$ref": "#/$defs/claimantRow"
                            },
                            {
                              "properties": {
                                "geography": {
                                  "const": "United Kingdom"
                                },
                                "geography_code": {
                                  "const": "K02000001"
                                },
                                "dimensions": {
                                  "properties": {
                                    "geography": {
                                      "const": "K02000001"
                                    }
                                  }
                                }
                              }
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "id": {
                      "pattern": "&observation="
                    }
                  }
                },
                "then": {
                  "properties": {
                    "data": {
                      "allOf": [
                        {
                          "$ref": "#/$defs/claimantRow"
                        },
                        {
                          "properties": {
                            "geography": {
                              "const": "United Kingdom"
                            },
                            "geography_code": {
                              "const": "K02000001"
                            },
                            "dimensions": {
                              "properties": {
                                "geography": {
                                  "const": "K02000001"
                                }
                              }
                            }
                          }
                        }
                      ]
                    },
                    "observations": {
                      "minItems": 1,
                      "maxItems": 1
                    }
                  }
                },
