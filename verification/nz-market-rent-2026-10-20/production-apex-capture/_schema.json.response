                  "ok",
                  "error"
                ]
              },
              "row_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 25
              },
              "period_start": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date"
              },
              "period_end": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date"
              }
            },
            "if": {
              "properties": {
                "status": {
                  "const": "ok"
                }
              }
            },
            "then": {
              "required": [
                "table_counts"
              ],
              "properties": {
                "row_count": {
                  "minimum": 1
                },
                "period_start": {
                  "type": "string",
                  "format": "date"
                },
                "period_end": {
                  "type": "string",
                  "format": "date"
                },
                "table_counts": {
                  "type": "object",
                  "required": [
                    "apartment",
                    "boarding-house",
                    "flat",
                    "house",
                    "room"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "apartment": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 5
                    },
                    "boarding-house": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 5
                    },
                    "flat": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 5
                    },
                    "house": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 5
                    },
                    "room": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 5
                    }
                  }
                }
              },
              "not": {
                "required": [
                  "error"
                ]
              }
            },
            "else": {
              "required": [
                "error"
              ],
              "properties": {
                "error": {
                  "type": "string",
                  "minLength": 1
                },
                "row_count": {
                  "const": 0
                },
                "period_start": {
                  "type": "null"
                },
                "period_end": {
                  "type": "null"
                }
              }
            }
          }
        },
        "metadata": {
          "type": "object",
          "required": [
            "count",
            "location_count",
            "successful_location_count",
            "period_start",
            "period_end",
            "window_consistent",
            "publication_time",
            "revision_id"
          ],
          "additionalProperties": false,
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 50
            },
            "location_count": {
              "const": 2
            },
            "successful_location_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            },
            "period_start": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "period_end": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "window_consistent": {
              "type": "boolean"
            },
            "publication_time": {
              "type": "null"
            },
            "revision_id": {
              "type": "null"
            }
          }
        },
        "provenance": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": [
              "location_id",
              "url",
              "retrieved_at",
              "sha256",
              "bytes"
            ],
            "properties": {
              "location_id": {
                "enum": [
                  "nz-auckland-avondale",
                  "nz-wellington-kelburn"
                ]
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "retrieved_at": {
                "type": "string",
                "format": "date-time"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 131072
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "location_id": {
                      "const": "nz-auckland-avondale"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "url": {
                      "const": "https://www.tenancy.govt.nz/market-rent-api/updateMarketValueLocation?ajax_city=Auckland&ajax_suburb=Avondale"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "location_id": {
                      "const": "nz-wellington-kelburn"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "url": {
                      "const": "https://www.tenancy.govt.nz/market-rent-api/updateMarketValueLocation?ajax_city=Wellington&ajax_suburb=Kelburn"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "ok"
              }
            }
          },
          "then": {
            "properties": {
              "rows": {
                "minItems": 2
              },
              "locations": {
                "items": {
                  "properties": {
                    "status": {
                      "const": "ok"
                    }
                  }
                }
              },
              "metadata": {
                "properties": {
                  "successful_location_count": {
                    "const": 2
                  },
                  "count": {
                    "minimum": 2
                  },
                  "window_consistent": {
                    "const": true
                  },
                  "period_start": {
                    "type": "string"
                  },
                  "period_end": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "degraded"
              }
            }
          },
          "then": {
            "properties": {
              "rows": {
                "minItems": 1
              },
              "metadata": {
                "properties": {
                  "count": {
                    "minimum": 1
                  },
                  "successful_location_count": {
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "error"
              }
            }
          },
          "then": {
            "properties": {
              "rows": {
                "maxItems": 0
              },
              "locations": {
                "items": {
                  "properties": {
                    "status": {
                      "const": "error"
                    }
                  }
                }
              },
              "metadata": {
                "properties": {
                  "count": {
                    "const": 0
                  },
                  "successful_location_count": {
                    "const": 0
                  },
                  "window_consistent": {
                    "const": false
                  },
                  "period_start": {
                    "type": "null"
                  },
                  "period_end": {
                    "type": "null"
                  }
                }
              }
            }
          }
        }
      ]
    },
