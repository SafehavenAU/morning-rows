          "geography_code": "N92000002",
          "population": "All sexes, age 16 and over: Jobseeker’s Allowance claimants and relevant Universal Credit claimants under the publisher’s claimant-count eligibility and administrative definitions.",
          "unit": "persons",
          "adjustment": "not seasonally adjusted",
          "kind": "observation",
