                      "minimum": 0,
                      "maximum": 5
                    },
                    "boarding-house": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 5
                    },
                    "flat": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 5
                    },
                    "house": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 5
                    },
                    "room": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 5
                    }
                  }
                }
              },
