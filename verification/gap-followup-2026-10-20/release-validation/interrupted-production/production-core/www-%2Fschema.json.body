          "const": "Creative Commons Attribution 3.0 New Zealand"
        },
        "licence_url": {
          "const": "https://creativecommons.org/licenses/by/3.0/nz/"
        },
        "definition": {
          "const": {
            "population": "Non-government properties with rental bonds lodged in the displayed six-month window; not advertised rents or every existing tenancy.",
            "adjustment": "unadjusted descriptive statistics",
            "period_convention": "Inclusive six-month window, from the first day of a month through the last day of the sixth consecutive month; not a monthly observation.",
            "limitations": "Only two explicitly supported publisher NZAD suburbs, qualified by city; site locality IDs are not official geography codes and do not establish TA, SA2 or postal boundaries. Figures are provisional, incomplete or revisable during bond-system migration. Late lodgements and administrative changes can alter results; no rent-trend inference is established. Absent dwelling/bedroom tuples are not_reported, not zero or inferred suppression.",
            "geography_authority": "Publisher NZAD suburb qualified by city; site-owned locality identifiers.",
            "active_bonds": "Current bonds within the displayed six-month window. The full-page tooltip also requires complete rent, dwelling, bedroom and address information. This is not all lodged bonds, all current tenancies, listings or an established denominator for the rent quantiles.",
            "rent_unit": "NZD per week",
            "count_unit": "bonds",
            "methodology_url": "https://www.tenancy.govt.nz/rent-bond-and-bills/market-rent/market-rent-explained/",
            "provisional_caveat_url": "https://www.tenancy.govt.nz/about-tenancy-services/data-and-statistics/rental-bond-data/",
            "revision_policy": "Updated monthly, omitting the most recent month; late lodgements and administrative changes can revise results. No official publication timestamp or revision identifier is supplied."
          }
        },
        "limitations": {
          "const": "Only two explicitly supported publisher NZAD suburbs, qualified by city; site locality IDs are not official geography codes and do not establish TA, SA2 or postal boundaries. Figures are provisional, incomplete or revisable during bond-system migration. Late lodgements and administrative changes can alter results; no rent-trend inference is established. Absent dwelling/bedroom tuples are not_reported, not zero or inferred suppression."
        },
        "published_at": {
          "type": "null"
        },
        "publisher_updated_at": {
          "type": "null"
        },
        "next_expected_update": {
          "type": "null"
        },
        "locations": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "allOf": [
            {
              "contains": {
                "properties": {
