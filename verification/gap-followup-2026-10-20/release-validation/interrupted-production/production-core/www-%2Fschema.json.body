              "type": "string",
              "pattern": "^(?:19|20|21)\\d{2}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])$",
              "format": "date"
            },
            "end": {
              "type": "string",
              "pattern": "^(?:19|20|21)\\d{2}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])$",
              "format": "date"
            },
            "calendar_days": {
              "const": 31
            }
          }
        },
        "rows": {
          "type": "array",
          "minItems": 2,
          "maxItems": 62,
          "prefixItems": [
            {
              "$ref": "#/$defs/gapBocRow0"
