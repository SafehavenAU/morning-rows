          "const": "Learning activity delivered by Scottish colleges, all funding sources; not Scottish-domiciled residents, university activity or individual student headcounts."
        },
        "definition": {
          "const": "One full-time equivalent is 15 credits or 600 learning hours. Further and higher education activity is grouped by full-time and part-time mode."
        },
        "rounding": {
          "const": "Published FTE values are rounded to the nearest five. Totals are calculated from unrounded data and can differ from rounded component sums."
        },
        "missingness": {
          "const": "Numeric zero is valid. Blank, absent, suppression or error cells are not converted to zero by this contract; a newly blank selected cell requires review of the edition-specific disclosure rule."
        },
        "revision_policy": {
          "const": "The named edition may be corrected. Retain the input digest and publication date; no immutable vintage or automatic adoption of a newer edition is claimed."
        },
        "limitations": {
          "const": "The total overlaps the four components. FTE is learning volume, not people or available places. This fixed 2024-25 edition is not a claim that a newer release cannot exist. No demographic or geographic inference beyond college activity in Scotland."
        },
        "statistical_status": {
          "const": "Official Statistics"
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "url",
              "retrieved_at",
              "bytes",
              "sha256"
            ],
            "properties": {
              "role": {
