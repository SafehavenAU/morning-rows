    "marketRentNative": {
      "type": "object",
      "required": [
        "status",
        "rows",
        "locations",
        "publisher",
        "licence",
        "licence_url",
        "definition",
        "limitations",
        "metadata",
        "provenance",
        "published_at",
        "publisher_updated_at",
        "next_expected_update"
      ],
      "properties": {
        "status": {
          "enum": [
            "ok",
            "degraded",
            "error"
          ]
        },
        "rows": {
          "type": "array",
          "maxItems": 50,
          "items": {
