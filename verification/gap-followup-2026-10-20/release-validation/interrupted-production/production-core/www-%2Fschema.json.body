    "remainingCmhcDefinition0": {
      "const": {
        "id": "victoria.two_bedroom_average_rent",
        "name": "Two-bedroom weighted average monthly rent",
        "geography": "Victoria, British Columbia",
        "geography_type": "Census metropolitan area",
        "dguid": "2011S0503935",
        "unit": "CAD per month",
        "population": "Two-bedroom units in eligible privately initiated row and apartment structures of three units and over, including vacant and occupied units and new and existing structures.",
        "definition": "CMHC Rental Market Survey weighted average monthly rent for the selected two-bedroom combined row-and-apartment category.",
        "adjustment": "Not specified by the selected publisher metadata",
        "kind": "observation",
        "cadence": "annual",
        "period_convention": "YYYY identifies the October survey year. The annual publisher reference is January 1 and the raw reference is October 1; this is not an average over twelve calendar months.",
        "dimensions": {
          "product": "34100133",
          "coordinate": "186.3.3.0.0.0.0.0.0.0",
          "vector": "3823106",
          "geography": "186",
          "structure": "3",
          "unit_type": "3"
        },
        "publisher": "Statistics Canada",
        "original_publisher": "Canada Mortgage and Housing Corporation",
        "licence": "CMHC Licence Agreement for the Use of Data",
        "licence_url": "https://www.cmhc-schl.gc.ca/about-us/terms-conditions/hmip-terms-conditions",
        "licence_conditions": "Using these CMHC data constitutes agreement to the linked CMHC Licence Agreement. Any redistribution must require recipients to agree to those terms; preserve attribution, accuracy and the no-endorsement notice. No recipient acceptance is recorded by this response.",
        "source_url": "https://www150.statcan.gc.ca/t1/tbl1/en/tv.action?pid=3410013301",
        "methodology_url": "https://www.cmhc-schl.gc.ca/professionals/housing-markets-data-and-research/housing-research/surveys/methods/methodology-rental-market-survey",
        "revision_policy": "Use the latest annual point only when it matches the current cube vintage and release. Preserve preliminary/revised symbols and release metadata; no substitution with an older year.",
        "limitations": "Annual October survey benchmark, not a current asking-rent quote, median, apartment-only estimate, municipality-wide total or housing-availability measure. Includes vacant and occupied units and new and existing structures. Geographical areas may change with census definitions, so historical values are not strictly comparable. A symbol of none does not establish finality."
      }
    },
