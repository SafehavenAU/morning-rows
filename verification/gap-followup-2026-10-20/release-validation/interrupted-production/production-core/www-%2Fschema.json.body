              },
              "retrieved_at": {
                "type": "string",
                "format": "date-time"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 131072
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "location_id": {
                      "const": "nz-auckland-avondale"
                    }
                  }
                },
                "then": {
