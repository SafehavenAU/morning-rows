              },
              "retrieved_at": {
                "type": "string",
                "pattern": "^(?:19|20|21)\\d{2}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{3})?Z$",
                "format": "date-time"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 131072
              },
              "sha256": {
