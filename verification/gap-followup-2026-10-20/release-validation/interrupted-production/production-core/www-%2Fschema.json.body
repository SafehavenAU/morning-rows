    "gapBocDefinition0": {
      "const": {
        "id": "FXUSDCAD",
        "name": "Daily average exchange rate of the US dollar in Canadian dollars.",
        "definition": "Daily average exchange rate of the US dollar in Canadian dollars.",
        "geography": "Canada (CAD quote-currency jurisdiction; not a regional transaction rate)",
        "population": "Indicative averages of aggregated financial-institution price quotes; not an executable transaction quote.",
        "unit": "CAD per USD",
        "adjustment": "Nominal; not seasonally adjusted",
        "kind": "observation",
        "period_convention": "Publisher observation calendar date, YYYY-MM-DD; no UTC offset or publication instant is implied. Request bounds use UTC dates.",
        "cadence": "business daily; normally by 16:30 Eastern Time, publication may be delayed",
        "revision_policy": "Published observations may change; no immutable vintage or finality guarantee is established. Retrieval does not advance independent verification.",
        "dimensions": {
          "series": "FXUSDCAD",
          "base_currency": "USD",
          "quote_currency": "CAD"
        },
        "publisher": "Bank of Canada",
        "licence": "Bank of Canada terms of use",
        "licence_url": "https://www.bankofcanada.ca/terms/",
        "source_url": "https://www.bankofcanada.ca/rates/exchange/daily-exchange-rates/",
        "limitations": "No inversion, interpolation, carry-forward or conversion calculation. A date absent from the validated response is not_published_on_date, not an inferred holiday. No business calendar, transaction rate or tax ruling is supplied.",
        "reuse_notice": "Original information is available free from Bank of Canada. Values are untransformed; selection and JSON representation are by Morning Rows."
      }
    },
    "gapBocDefinition1": {
      "const": {
        "id": "FXGBPCAD",
        "name": "Daily average exchange rate of the UK pound sterling in Canadian dollars.",
        "definition": "Daily average exchange rate of the UK pound sterling in Canadian dollars.",
        "geography": "Canada (CAD quote-currency jurisdiction; not a regional transaction rate)",
        "population": "Indicative averages of aggregated financial-institution price quotes; not an executable transaction quote.",
        "unit": "CAD per GBP",
        "adjustment": "Nominal; not seasonally adjusted",
        "kind": "observation",
        "period_convention": "Publisher observation calendar date, YYYY-MM-DD; no UTC offset or publication instant is implied. Request bounds use UTC dates.",
        "cadence": "business daily; normally by 16:30 Eastern Time, publication may be delayed",
        "revision_policy": "Published observations may change; no immutable vintage or finality guarantee is established. Retrieval does not advance independent verification.",
        "dimensions": {
          "series": "FXGBPCAD",
          "base_currency": "GBP",
          "quote_currency": "CAD"
        },
        "publisher": "Bank of Canada",
        "licence": "Bank of Canada terms of use",
        "licence_url": "https://www.bankofcanada.ca/terms/",
        "source_url": "https://www.bankofcanada.ca/rates/exchange/daily-exchange-rates/",
        "limitations": "No inversion, interpolation, carry-forward or conversion calculation. A date absent from the validated response is not_published_on_date, not an inferred holiday. No business calendar, transaction rate or tax ruling is supplied.",
        "reuse_notice": "Original information is available free from Bank of Canada. Values are untransformed; selection and JSON representation are by Morning Rows."
      }
    },
