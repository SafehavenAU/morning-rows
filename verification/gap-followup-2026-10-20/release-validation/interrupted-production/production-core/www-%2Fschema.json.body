                  }
                }
              },
              "minContains": 1,
              "maxContains": 1
            }
          ],
          "items": {
            "type": "object",
            "required": [
              "id",
              "status",
              "period_start",
              "period_end",
              "row_count"
            ],
            "properties": {
              "id": {
                "enum": [
                  "nz-auckland-avondale",
                  "nz-wellington-kelburn"
                ]
              },
              "status": {
                "enum": [
                  "ok",
                  "error"
                ]
              },
              "row_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 25
              },
              "period_start": {
                "type": [
                  "string",
                  "null"
                ],
