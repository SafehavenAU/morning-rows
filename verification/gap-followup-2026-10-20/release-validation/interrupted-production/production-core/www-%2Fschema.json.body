        "geography": "Northern Ireland",
        "unit": "%",
        "kind": "observation",
        "population": "Electricity generated and consumed in Northern Ireland, including metered and own-use generation; gross final consumption includes net imports and system losses.",
        "adjustment": "Physical electricity quantities; not seasonally adjusted",
        "period_convention": "Inclusive fixed rolling twelve-month window 2025-07-01/2026-06-30; month labels are not individual monthly observations",
        "cadence": "Fixed 3 September 2026 edition; future editions require review",
