                  "properties": {
                    "data": {
                      "type": "array",
                      "minItems": 13,
                      "maxItems": 13,
                      "items": {
                        "allOf": [
                          {
                            "$ref": "#/$defs/claimantRow"
                          },
                          {
                            "properties": {
                              "geography": {
                                "const": "United Kingdom"
                              },
                              "geography_code": {
                                "const": "K02000001"
                              },
                              "dimensions": {
                                "properties": {
                                  "geography": {
                                    "const": "K02000001"
                                  }
                                }
                              }
                            }
                          }
                        ]
                      }
                    },
                    "observations": {
                      "minItems": 13,
                      "maxItems": 13
                    }
                  }
                }
              }
            ]
          }
