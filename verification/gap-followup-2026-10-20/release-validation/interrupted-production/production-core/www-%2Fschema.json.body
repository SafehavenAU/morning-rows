    "statcanGdpDefinition": {
      "type": "object",
      "enum": [
        {
          "geography": "Canada",
          "population": "Expenditure-based gross domestic product at market prices for the Canadian economy; not per-capita GDP, household income, gross domestic income or an expenditure component.",
          "price_basis": "Chained (2017) dollars",
          "period_convention": "Calendar quarter identified by YYYY-Qn, with inclusive quarter boundaries. The legacy period field is the quarter-start month YYYY-MM, not a monthly observation.",
          "cadence": "quarterly",
          "dimensions": {
            "product": "36100104",
            "coordinate": "1.1.1.30.0.0.0.0.0.0",
            "vector": "62305752",
            "geography": "1",
            "prices": "1",
            "seasonal_adjustment": "1",
            "estimates": "30"
          },
          "publisher": "Statistics Canada",
          "licence": "Statistics Canada Open Licence",
          "licence_url": "https://www.statcan.gc.ca/en/terms-conditions/open-licence",
          "source_url": "https://www150.statcan.gc.ca/t1/tbl1/en/tv.action?pid=3610010401",
          "revision_policy": "Current and earlier quarters can be revised with new or revised inputs and seasonal information; preserve raw release times and preliminary/revised symbols. A rebase or changed series definition requires review.",
          "limitations": "Chained-dollar components are not additive. Level is expressed at an annual rate; quarter_change is ordinary, nonannualized quarter-to-quarter percentage change derived from publisher-rounded levels. No currency conversion or vintage archive. Symbol none does not establish finality or absence of revisions.",
          "id": "level",
          "name": "Real gross domestic product at market prices",
          "unit": "millions of chained (2017) dollars",
          "adjustment": "Seasonally adjusted at annual rates",
          "kind": "observation",
          "definition": "Reported expenditure-based GDP level in millions of chained (2017) dollars, seasonally adjusted at annual rates."
        },
        {
          "geography": "Canada",
          "population": "Expenditure-based gross domestic product at market prices for the Canadian economy; not per-capita GDP, household income, gross domestic income or an expenditure component.",
          "price_basis": "Chained (2017) dollars",
          "period_convention": "Calendar quarter identified by YYYY-Qn, with inclusive quarter boundaries. The legacy period field is the quarter-start month YYYY-MM, not a monthly observation.",
          "cadence": "quarterly",
          "dimensions": {
            "product": "36100104",
            "coordinate": "1.1.1.30.0.0.0.0.0.0",
            "vector": "62305752",
            "geography": "1",
            "prices": "1",
            "seasonal_adjustment": "1",
            "estimates": "30"
          },
          "publisher": "Statistics Canada",
          "licence": "Statistics Canada Open Licence",
          "licence_url": "https://www.statcan.gc.ca/en/terms-conditions/open-licence",
          "source_url": "https://www150.statcan.gc.ca/t1/tbl1/en/tv.action?pid=3610010401",
          "revision_policy": "Current and earlier quarters can be revised with new or revised inputs and seasonal information; preserve raw release times and preliminary/revised symbols. A rebase or changed series definition requires review.",
          "limitations": "Chained-dollar components are not additive. Level is expressed at an annual rate; quarter_change is ordinary, nonannualized quarter-to-quarter percentage change derived from publisher-rounded levels. No currency conversion or vintage archive. Symbol none does not establish finality or absence of revisions.",
          "id": "quarter_change",
          "name": "Real GDP quarter-to-quarter change",
          "unit": "percent",
          "adjustment": "Ordinary quarter-to-quarter change in seasonally adjusted annual-rate levels; not annualized",
          "kind": "derived",
          "definition": "Percentage change between the latest two adjacent reported quarterly GDP levels; derived by Morning Rows.",
          "formula": "100 * (current_value / previous_value - 1)",
          "rounding": "Two decimal percentage points, using Math.round(unrounded * 100) / 100 on the ratio of publisher-rounded levels."
        }
      ]
    },
