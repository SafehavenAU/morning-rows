    {
      "sheet": "Definitions and data notes",
      "member": "xl/worksheets/sheet11.xml",
      "coordinate": "A5",
      "original_type": "s",
      "original_value_text": "Year"
    },
    {
      "sheet": "Definitions and data notes",
      "member": "xl/worksheets/sheet11.xml",
      "coordinate": "B5",
      "original_type": "s",
      "original_value_text": "This data is extracted based on the charge outcome year of each finalised charge (e.g. the year the person was convicted and sentenced or found not guilty, or the year the charge was withdrawn or dismissed). Calendar years start in January and end in December. Financial years start in July and end in June."
    },
    {
      "sheet": "Definitions and data notes",
      "member": "xl/worksheets/sheet11.xml",
      "coordinate": "A7",
      "original_type": "s",
      "original_value_text": "People convicted per year"
    },
    {
      "sheet": "Definitions and data notes",
      "member": "xl/worksheets/sheet11.xml",
      "coordinate": "B7",
      "original_type": "s",
      "original_value_text": "People are counted once per year for their most serious charge convicted in the year, and only the details of that charge are shown."
    },
    {
      "sheet": "Definitions and data notes",
      "member": "xl/worksheets/sheet11.xml",
      "coordinate": "A14",
      "original_type": "s",
      "original_value_text": "Differences from data on Aotearoa Data Explorer"
    },
    {
      "sheet": "Definitions and data notes",
      "member": "xl/worksheets/sheet11.xml",
      "coordinate": "B14",
      "original_type": "s",
      "original_value_text": "The number of people with finalised charges in this workbook will differ from that available in the 'Adults with finalised charges in court – most serious offence' and 'Adults convicted in court by sentence type - most serious offence' tables on Stats New Zealand's Aotearoa Data Explorer. This is because this workbook counts all people with finalised charges, whereas the NZ.Stat tables display data separately for children and young people and for adults."
    },
    {
      "sheet": "Definitions and data notes",
      "member": "xl/worksheets/sheet11.xml",
      "coordinate": "A15",
      "original_type": "s",
      "original_value_text": "Values of - and 0"
    },
    {
      "sheet": "Definitions and data notes",
      "member": "xl/worksheets/sheet11.xml",
      "coordinate": "B15",
      "original_type": "s",
      "original_value_text": "Where information is not existing for a measure, a dash (-) is used in the tables. A count of zero is represented by a numerical 0.\nWhere a percentage value is 0% it is shown as 0%, where it is between 0% and 0.49% it is shown as <1%, and where it is between 0.5% and 1% it is shown as 1%."
    }
