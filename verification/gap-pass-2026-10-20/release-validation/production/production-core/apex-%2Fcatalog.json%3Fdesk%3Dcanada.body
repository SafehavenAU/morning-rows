      "measure_count": 2,
      "limits": "Canada expenditure-based GDP at market prices, millions of chained (2017) dollars, seasonally adjusted at annual rates. Two adjacent quarterly levels and one derived, nonannualized quarter-on-quarter percent change only. The annual-rate level is not annualized growth. The legacy period field is a quarter-start-month alias, not monthly GDP. No nominal, per-capita, household-income or arbitrary-history selection is implied; figures can be revised.",
      "selection": "Source selection preserves the native period, level and quarter_change fields. Level selects two quarters; quarter_change selects only the latest derived comparison. An observation selects an exact retained YYYY-Qn quarter.",
      "measures": [
        {
          "id": "level",
          "name": "Real gross domestic product at market prices",
          "geography": "Canada",
          "unit": "millions of chained (2017) dollars",
          "kind": "observation",
