          "definition": {
            "geography": "Canada",
            "population": "Expenditure-based gross domestic product at market prices for the Canadian economy; not per-capita GDP, household income, gross domestic income or an expenditure component.",
            "price_basis": "Chained (2017) dollars",
            "period_convention": "Calendar quarter identified by YYYY-Qn, with inclusive quarter boundaries. The legacy period field is the quarter-start month YYYY-MM, not a monthly observation.",
